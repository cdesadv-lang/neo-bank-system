# PostgreSQL connection (role "neobank", database "neobank")
DATABASE_URL="postgresql://neobank:CHANGE_ME@localhost:5432/neobank?schema=public"
# Separate database used by the automated test suite (it is wiped by tests)
TEST_DATABASE_URL="postgresql://neobank:CHANGE_ME@localhost:5432/neobank_test?schema=public"
# 32+ random bytes, hex. Generate with: openssl rand -hex 32
SESSION_SECRET="CHANGE_ME"
# OTP provider: "console" (dev: prints codes to server log) | "sms-webhook"
OTP_PROVIDER="console"
# Used only when OTP_PROVIDER=sms-webhook
SMS_WEBHOOK_URL=""
SMS_WEBHOOK_TOKEN=""
APP_URL="http://localhost:3100"
# DEV ONLY: show OTP codes in the UI when OTP_PROVIDER=console (ignored in production)
DEMO_SHOW_OTP=1
