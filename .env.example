# PostgreSQL connection (role "neobank", database "neobank")
DATABASE_URL="postgresql://neobank:CHANGE_ME@localhost:5432/neobank?schema=public"
# Separate database used by the automated test suite (it is wiped by tests)
TEST_DATABASE_URL="postgresql://neobank:CHANGE_ME@localhost:5432/neobank_test?schema=public"
# 32+ random bytes, hex. Generate with: openssl rand -hex 32
SESSION_SECRET="CHANGE_ME"
# OTP provider: "console" (dev: prints codes to server log) | "sms-webhook"
OTP_PROVIDER="console"
# Used only when OTP_PROVIDER=sms-webhook
SMS_WEBHOOK_URL=""
SMS_WEBHOOK_TOKEN=""
APP_URL="http://localhost:3100"
# DEV ONLY: show OTP codes in the UI when OTP_PROVIDER=console (ignored in production)
DEMO_SHOW_OTP=1
# Cookies: "true" forces Secure cookies (required behind HTTPS in production); "false" allows http://localhost for `next start`
COOKIE_SECURE=""
# ISO 8583 switch endpoint (/api/switch/iso8583) shared secret, sent as the x-switch-key header. REQUIRED in production.
SWITCH_API_KEY="dev-switch-key-change-me"
# Switch timeout before automatic reversal (ms)
SWITCH_TIMEOUT_MS=30000
# Mock HSM keys (32+ chars). Production must use a certified HSM; the mock is refused unless ALLOW_MOCK_HSM=1.
HSM_MOCK_ZPK=""
HSM_MOCK_PVK=""
ALLOW_MOCK_HSM=0
# Production only: allow console OTP provider (NOT recommended)
ALLOW_CONSOLE_OTP=0
# Disable login/OTP rate limiting (tests only)
DISABLE_RATE_LIMIT=0
# Prisma query logging: "query" for verbose
PRISMA_LOG=""
# docker-compose only
POSTGRES_PASSWORD="CHANGE_ME"
DOMAIN="bank.example.com"
